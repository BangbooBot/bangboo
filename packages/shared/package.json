{
  "name": "bangboo-shared",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bun check",
    "lint": "bun fmt",
    "drizzle:generate": "bun x drizzle-kit generate",
    "auth:generate": "bun x auth@latest generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "latest",
    "@constatic/base": "latest",
    "better-auth": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "pg": "latest",
    "postgres": "latest",
    "zod": "latest"
  },
  "imports": {
    "#env": [
      "./src/env.ts"
    ],
    "#db": [
      "./src/db/index.ts"
    ],
    "#db-context": [
      "./src/db/context.ts"
    ],
    "#lib": [
      "./src/lib/index.ts"
    ],
    "#auth": [
      "./src/lib/auth.ts"
    ],
    "#dtos": [
      "./src/dtos/index.ts"
    ]
  }
}
