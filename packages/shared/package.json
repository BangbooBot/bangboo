{
  "name": "bangboo-shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Código compartilhado entre backend e bot: env, banco (Drizzle), auth (Better Auth), RBAC e DTOs.",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./utils": { "types": "./src/utils/index.ts", "default": "./src/utils/index.ts" },
    "./env": { "types": "./src/env/index.ts", "default": "./src/env/index.ts" },
    "./env/bot": { "types": "./src/env/bot.ts", "default": "./src/env/bot.ts" },
    "./env/backend": { "types": "./src/env/backend.ts", "default": "./src/env/backend.ts" },
    "./db": { "types": "./src/db/index.ts", "default": "./src/db/index.ts" },
    "./auth": { "types": "./src/auth/index.ts", "default": "./src/auth/index.ts" }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx --env-file .env drizzle-kit generate",
    "db:migrate": "bunx --env-file .env drizzle-kit migrate",
    "db:push": "bunx --env-file .env drizzle-kit push",
    "db:studio": "bunx --env-file .env drizzle-kit studio",
    "auth:schema": "bunx --env-file .env auth@latest generate --config src/auth/auth.ts --output /tmp/better-auth-schema.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
