# ───────── Comum ─────────
NODE_ENV=development
DATABASE_URL=postgres://bangboo:bangboo@localhost:5432/bangboo
GUILD_ID=
WEBHOOK_LOGS_URL=

# ───────── Bot ─────────
BOT_TOKEN=

# ───────── Backend ─────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Opcionais (padrão: http://localhost:<porta>)
BACKEND_URL=
FRONTEND_URL=

# Better Auth — mínimo 32 caracteres. Gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Discord OAuth2 (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Cadastre EXATAMENTE este valor em OAuth2 → Redirects. Padrão: ${BACKEND_URL}/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Expiração (segundos)
ACCESS_TOKEN_TTL=900          # JWT — 15 min
REFRESH_TOKEN_TTL=2592000     # sessão/refresh — 30 dias (deslizante)

# Discord IDs (separados por vírgula) que recebem o papel ROOT
ROOT_DISCORD_IDS=

# Opcionais
COOKIE_DOMAIN=
TRUST_PROXY=
