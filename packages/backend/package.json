{
  "name": "bangboo-backend",
  "version": "0.0.1",
  "description": "API do dashboard Bangboo (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --exec bun --env-file ../shared/.env",
    "start:dev": "nest start --exec bun --env-file ../shared/.env --watch",
    "start:debug": "nest start --exec bun --env-file ../shared/.env --debug --watch",
    "start:prod": "bun --env-file=../shared/.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "bun --env-file=../shared/.env.e2e test/e2e/auth-flow.ts",
    "start:e2e": "bun --env-file=../shared/.env.e2e --preload ./test/e2e/mock-discord.ts dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/throttler": "latest",
    "bangboo-shared": "workspace:*",
    "helmet": "latest",
    "jose": "latest",
    "nestjs-zod": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "prettier": "latest",
    "source-map-support": "latest",
    "supertest": "latest",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
