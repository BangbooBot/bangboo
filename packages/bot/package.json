{
  "name": "bangboo-bot",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit && echo \u2714 Ok",
    "build": "tsc",
    "dev": "bun --env-file=../shared/.env ./src/index.ts",
    "dev:dev": "bun --env-file=../shared/.env.dev ./src/index.ts",
    "watch": "bun --watch --env-file=../shared/.env ./src/index.ts",
    "watch:dev": "bun --watch --env-file=../shared/.env.dev ./src/index.ts",
    "start": "bun --env-file=../shared/.env .",
    "start:dev": "bun --env-file=../shared/.env.dev .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bangboo-shared": "workspace:*",
    "@constatic/base": "^0.1.1",
    "@magicyan/discord": "^1.7.4",
    "chalk": "^6.0.1",
    "discord.js": "^14.27.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "imports": {
    "#base": [
      "./build/discord/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ]
  },
  "baseVersion": "1.5.9"
}
