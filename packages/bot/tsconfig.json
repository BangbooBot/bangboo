{
	"extends": "@constatic/base/tsconfig",
	"compilerOptions": {
		"types": ["bun"],
		// Output Options
		"outDir": "./build",
		"rootDir": "./src",

		// Path mapping Options (apenas pastas que existem; recrie o alias ao criar a pasta)
		"paths": {
			"#base": ["./src/discord/index.ts"],
			"#functions": ["./src/functions/index.ts"]
		}
	},

	"include": ["src"],
	"exclude": ["node_modules"]
}
